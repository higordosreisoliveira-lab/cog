{
  "name": "cognitivai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p server/tsconfig.json && tsx scripts/check-locales.mjs && vite build && tsx scripts/build-shell.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:i18n": "tsx scripts/check-locales.mjs",
    "start": "node dist-server/server/index.js",
    "dev:server": "tsx watch server/index.ts",
    "seed": "tsx server/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "country-flag-icons": "^1.6.20",
    "qrcode-generator": "^1.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
